{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-pack.v1.json",
  "title": "Case Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_pack_id", "generated_at", "mix", "seed", "cases"],
  "properties": {
    "case_pack_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "mix": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "borrower_id", "requested_amount", "documents"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "borrower_id": { "type": "string", "minLength": 1 },
          "requested_amount": { "type": "number", "minimum": 0 },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id", "type"],
              "properties": {
                "document_id": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
